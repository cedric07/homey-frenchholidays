{
  "id": "com.cedric07.dayinfo",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Day Info",
    "fr": "Informations du jour"
  },
  "description": {
    "en": "Public holidays, school vacations, moon phase and seasonal info for France.",
    "fr": "Jours fériés, vacances scolaires, phase lunaire et infos du jour pour la France."
  },
  "category": [
    "tools"
  ],
  "brandColor": "#3478B3",
  "permissions": [
    "homey:manager:geolocation"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Cédric Andrietti",
    "email": "cedric.andrietti@gmail.com"
  },
  "api": {
    "getSummary": {
      "method": "GET",
      "path": "/summary"
    },
    "sync": {
      "method": "POST",
      "path": "/sync"
    },
    "suggestZone": {
      "method": "GET",
      "path": "/suggest-zone"
    }
  }
}
