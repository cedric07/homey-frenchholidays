{
  "id": "com.cedric07.frenchholidays",
  "version": "1.1.3",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "French School Holidays",
    "fr": "Vacances scolaires en France"
  },
  "description": {
    "en": "Automate your home around French school holidays",
    "fr": "Automatisez votre maison autour des vacances scolaires"
  },
  "category": [
    "tools"
  ],
  "brandColor": "#002395",
  "permissions": [
    "homey:manager:geolocation"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Cédric Andrietti"
  },
  "support": "https://github.com/cedric07/homey-frenchholidays/issues",
  "source": "https://github.com/cedric07/homey-frenchholidays",
  "bugs": {
    "url": "https://github.com/cedric07/homey-frenchholidays/issues"
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "CedricAndrietti"
      }
    }
  },
  "api": {
    "getSummary": {
      "method": "GET",
      "path": "/summary"
    },
    "sync": {
      "method": "POST",
      "path": "/sync"
    },
    "suggestZone": {
      "method": "GET",
      "path": "/suggest-zone"
    }
  }
}