{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.cedric07.frenchholidays",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "French School Holidays",
    "fr": "Vacances scolaires en France"
  },
  "description": {
    "en": "French school vacations by zone (A/B/C…), plus regional public holidays for Homey.",
    "fr": "Vacances scolaires par zone (A/B/C…), et jours fériés régionaux pour Homey."
  },
  "category": [
    "tools"
  ],
  "brandColor": "#3478B3",
  "permissions": [
    "homey:manager:geolocation"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Cédric Andrietti",
    "email": "cedric.andrietti@gmail.com"
  },
  "support": "https://github.com/cedric07/homey-frenchholidays/issues",
  "api": {
    "getSummary": {
      "method": "GET",
      "path": "/summary"
    },
    "sync": {
      "method": "POST",
      "path": "/sync"
    },
    "suggestZone": {
      "method": "GET",
      "path": "/suggest-zone"
    }
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "It is a public holiday today",
          "fr": "C'est un jour férié aujourd'hui"
        },
        "tokens": [
          {
            "name": "public_holiday_label",
            "type": "string",
            "title": {
              "en": "Holiday name",
              "fr": "Nom du jour férié"
            }
          }
        ],
        "id": "public_holiday_today"
      },
      {
        "title": {
          "en": "Tomorrow is a public holiday",
          "fr": "Demain est un jour férié"
        },
        "tokens": [
          {
            "name": "public_holiday_label",
            "type": "string",
            "title": {
              "en": "Holiday name",
              "fr": "Nom du jour férié"
            }
          }
        ],
        "id": "public_holiday_tomorrow"
      },
      {
        "title": {
          "en": "School vacation ends today",
          "fr": "Les vacances scolaires se terminent aujourd'hui"
        },
        "tokens": [
          {
            "name": "school_holiday_label",
            "type": "string",
            "title": {
              "en": "Vacation label",
              "fr": "Libellé vacances"
            }
          },
          {
            "name": "days_until_school_holiday",
            "type": "number",
            "title": {
              "en": "Days until next vacation",
              "fr": "Jours avant prochaines vacances"
            }
          }
        ],
        "id": "school_holiday_ends"
      },
      {
        "title": {
          "en": "School vacation starts today",
          "fr": "Les vacances scolaires commencent aujourd'hui"
        },
        "tokens": [
          {
            "name": "school_holiday_label",
            "type": "string",
            "title": {
              "en": "Vacation label",
              "fr": "Libellé vacances"
            }
          },
          {
            "name": "days_until_school_holiday_end",
            "type": "number",
            "title": {
              "en": "Days until end",
              "fr": "Jours avant la fin"
            }
          }
        ],
        "id": "school_holiday_starts"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "Days until next public holiday is at most...",
          "fr": "Jours avant le prochain jour férié ≤ ..."
        },
        "titleFormatted": {
          "en": "Days until next public holiday !{{is|is not}} at most [[days]]",
          "fr": "Jours avant le prochain jour férié !{{≤|>}} [[days]]"
        },
        "args": [
          {
            "type": "number",
            "name": "days",
            "title": {
              "en": "Days",
              "fr": "Jours"
            },
            "min": 0,
            "max": 365,
            "placeholder": {
              "en": "7",
              "fr": "7"
            }
          }
        ],
        "id": "days_until_public_holiday_lte"
      },
      {
        "title": {
          "en": "Days until next school vacation is at most...",
          "fr": "Jours avant les prochaines vacances scolaires ≤ ..."
        },
        "titleFormatted": {
          "en": "Days until next school vacation !{{is|is not}} at most [[days]]",
          "fr": "Jours avant les prochaines vacances !{{≤|>}} [[days]]"
        },
        "args": [
          {
            "type": "number",
            "name": "days",
            "title": {
              "en": "Days",
              "fr": "Jours"
            },
            "min": 0,
            "max": 365,
            "placeholder": {
              "en": "7",
              "fr": "7"
            }
          }
        ],
        "id": "days_until_school_holiday_lte"
      },
      {
        "title": {
          "en": "It is a public holiday",
          "fr": "C'est un jour férié"
        },
        "titleFormatted": {
          "en": "It !{{is|is not}} a public holiday",
          "fr": "C'!{{est|est pas}} un jour férié"
        },
        "id": "is_public_holiday"
      },
      {
        "title": {
          "en": "It is school vacation",
          "fr": "Ce sont les vacances scolaires"
        },
        "titleFormatted": {
          "en": "It !{{is|is not}} school vacation",
          "fr": "Ce !{{sont|ne sont pas}} les vacances scolaires"
        },
        "id": "is_school_holiday"
      }
    ]
  },
  "widgets": {
    "day-summary": {
      "name": {
        "en": "Today",
        "fr": "Aujourd'hui"
      },
      "height": "60%",
      "transparent": false,
      "api": {
        "getSummary": {
          "method": "GET",
          "path": "/"
        }
      },
      "id": "day-summary",
      "settings": []
    }
  }
}